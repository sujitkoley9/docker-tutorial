# -------- Stage 1: Build environment (install dependencies) --------
FROM python:3.12-slim AS builder

# Set work directory
WORKDIR /app

# Install/update dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get clean

# Copy and install python dependencies
COPY requirements.txt requirements.txt
RUN pip install --upgrade pip && \
    pip install --prefix=/install --no-cache-dir -r requirements.txt

# -------- Stage 2: Runtime image --------
FROM python:3.12-slim as runtime

# Set work directory
WORKDIR /app

# Copy app code
COPY . .

# Adding new user "appuser"
RUN useradd -u 1000  -c "App user" -m appuser  

# Changing ownership of the files from "root" user to "appuser"
RUN chown -R appuser:appuser /app

# Changing read+write+execute to the folder "/app"  
RUN chmod -R 777 /app

# Switch to appuser
USER appuser

# Copy dependencies from builder
COPY --from=builder /install  /home/appuser/.local

# Ensure python can find the packages
ENV PATH=/home/appuser/.local/bin:$PATH

# Expose port
EXPOSE 8000

# Run app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
